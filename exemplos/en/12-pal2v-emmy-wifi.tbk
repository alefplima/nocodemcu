        {
          "type": "ard_function_def",
          "id": "@;!fF$N#/V{j6[ite?{)",
          "x": 40,
          "y": 880,
          "fields": {
            "TIPO": "void",
            "NOME": "sendPage",
            "PARAMS": "WiFiClient& c"
          },
          "inputs": {
            "BODY": {
              "block": {
                "type": "ard_raw_stmt",
                "id": "9`;tG4~Xy8{.be9cWRFZ",
                "icons": {
                  "comment": {
                    "text": "the whole page lives in the ESP32 flash: no internet, no CDN, nothing\nto install on the phone. Just open the IP the Monitor showed",
                    "pinned": false,
                    "height": 80,
                    "width": 160
                  }
                },
                "fields": {
                  "CODE": "c.print(R\"H(<!doctype html><html lang=en><head><meta charset=utf-8>\\n<meta name=viewport content=\"width=device-width,initial-scale=1\">\\n<title>Emmy - lattice</title><style>\\nbody{margin:0;padding:14px;background:#0f1115;color:#e6e6e6;text-align:center;\\nfont:14px ui-monospace,Menlo,monospace}\\ncanvas{max-width:100%}#est{font-size:26px;font-weight:700;margin:10px 0 2px}\\n.l{color:#8b93a7;font-size:12px;line-height:1.7}\\n</style></head><body>\\n<canvas id=cv width=360 height=360></canvas>\\n<div id=est>--</div><div class=l id=num></div>\\n<script>)H\");"
                },
                "next": {
                  "block": {
                    "type": "ard_raw_stmt",
                    "id": "`4_+M_7mz-)KPt#RIg!H",
                    "icons": {
                      "comment": {
                        "text": "the diamond is the boundary of what is reachable: |Gc| + |Gct| <= 1",
                        "pinned": false,
                        "height": 80,
                        "width": 160
                      }
                    },
                    "fields": {
                      "CODE": "c.print(R\"H(var cv=document.getElementById(\"cv\"),g=cv.getContext(\"2d\"),R=[];\\nfunction X(v){return 180+v*150}function Y(v){return 180-v*150}\\nfunction li(a,b,c,d){g.beginPath();g.moveTo(X(a),Y(b));g.lineTo(X(c),Y(d));g.stroke()}\\nfunction drawGrid(){g.clearRect(0,0,360,360);\\ng.strokeStyle=\"#2a2f3a\";g.lineWidth=1;\\nfor(var v=-0.75;v<0.8;v+=0.25){if(Math.abs(v)<0.01)continue;\\nvar m=1-Math.abs(v);li(-m,v,m,v);li(v,-m,v,m)}\\ng.strokeStyle=\"#5a6478\";g.lineWidth=2;g.beginPath();\\ng.moveTo(X(1),Y(0));g.lineTo(X(0),Y(1));g.lineTo(X(-1),Y(0));\\ng.lineTo(X(0),Y(-1));g.closePath();g.stroke();)H\");"
                    },
                    "next": {
                      "block": {
                        "type": "ard_raw_stmt",
                        "id": "4p.Th.4];IC,q:y%~@q4",
                        "icons": {
                          "comment": {
                            "text": "dashed at +-0.5 = the control values. The diagonals separate the\nnon-extreme states. It is the same geometry as the IDE Lattice tab",
                            "pinned": false,
                            "height": 80,
                            "width": 160
                          }
                        },
                        "fields": {
                          "CODE": "c.print(R\"H(g.strokeStyle=\"#7a8698\";g.lineWidth=1;g.setLineDash([4,4]);\\n[0.5,-0.5].forEach(function(v){var m=1-Math.abs(v);li(v,-m,v,m);li(-m,v,m,v)});\\ng.setLineDash([]);li(-0.5,-0.5,0.5,0.5);li(-0.5,0.5,0.5,-0.5);\\ng.strokeStyle=\"#3a4152\";li(-1,0,1,0);li(0,-1,0,1);\\ng.fillStyle=\"#e6e6e6\";g.font=\"600 14px monospace\";\\ng.textAlign=\"center\";g.textBaseline=\"middle\";\\ng.fillText(\"V\",X(1)+14,Y(0));g.fillText(\"F\",X(-1)-14,Y(0));\\ng.fillText(\"T\",X(0),Y(1)-14);g.fillText(\"⊥\",X(0),Y(-1)+14);}\\n)H\");"
                        },
                        "next": {
                          "block": {
                            "type": "ard_raw_stmt",
                            "id": "utzdoWMH.#sT1wA4[d3s",
                            "icons": {
                              "comment": {
                                "text": "the trail keeps the last 120 points: you can see the path of the\ndecision inside the lattice, not just the current point",
                                "pinned": false,
                                "height": 80,
                                "width": 160
                              }
                            },
                            "fields": {
                              "CODE": "c.print(R\"H(function pt(a,b,al,cor){g.globalAlpha=al;g.fillStyle=cor;\\ng.beginPath();g.arc(X(a),Y(b),al>0.9?6:3,0,6.3);g.fill();g.globalAlpha=1}\\nfunction paint(){drawGrid();for(var i=0;i<R.length;i++)\\npt(R[i][0],R[i][1],0.12+0.5*(i+1)/R.length,\"#4da3ff\");\\nif(R.length){var u=R[R.length-1];pt(u[0],u[1],1,\"#ff5c5c\")}}\\nfunction tick(){fetch(\"/d\").then(function(r){return r.text()}).then(function(t){\\nvar p=t.split(\",\"),mu=+p[0],lam=+p[1],gc=mu-lam,gct=mu+lam-1;\\nR.push([gc,gct]);if(R.length>120)R.shift();paint();\\ndocument.getElementById(\"est\").textContent=p[3];\\ndocument.getElementById(\"num\").textContent=\"mu \"+mu.toFixed(3)+\\n\"   lambda \"+lam.toFixed(3)+\"   Gc \"+gc.toFixed(3)+\"   Gct \"+gct.toFixed(3)+\\n\"   |   left \"+p[4]+\" cm    right \"+p[5]+\" cm\"}).catch(function(){\\ndocument.getElementById(\"est\").textContent=\"no signal\"})}\\ndrawGrid();setInterval(tick,300);</script></body></html>)H\");"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "ard_function_def",
          "id": "BW.*fu-pS,TC~!vQEKJ,",
          "x": 40,
          "y": 1210,
          "fields": {
            "TIPO": "void",
            "NOME": "serveWeb",
            "PARAMS": ""
          },
          "inputs": {
            "BODY": {
              "block": {
                "type": "ard_raw_stmt",
                "id": "Z$2!xO8Gsb0.NF=Y5v~}",
                "icons": {
                  "comment": {
                    "text": "the server is static in here because only this function needs it - it\nis created on the first call and lives for the whole program. With no\nclient waiting, the function returns at once: the robot waits for no\none",
                    "pinned": false,
                    "height": 80,
                    "width": 160
                  }
                },
                "fields": {
                  "CODE": "static WiFiServer server(80);\\nstatic bool started = false;\\nif (!started) { server.begin(); started = true; }\\nWiFiClient c = server.available();\\nif (!c) return;\\nunsigned long t0 = millis();\\nwhile (c.connected() && !c.available() && millis() - t0 < 300) delay(1);\\nString req = c.readStringUntil('\\r');\\nwhile (c.available()) c.read();"
                },
                "next": {
                  "block": {
                    "type": "ard_raw_stmt",
                    "id": "`AV*MKFt5TrF}}*[g_(Z",
                    "icons": {
                      "comment": {
                        "text": "the /d route returns the raw annotation, on one line: mu, lambda,\nstate code, state name and both distances. The drawing is done by the\nbrowser",
                        "pinned": false,
                        "height": 80,
                        "width": 160
                      }
                    },
                    "fields": {
                      "CODE": "if (req.indexOf(\"GET /d\") >= 0) {\\n  c.println(F(\"HTTP/1.1 200 OK\"));\\n  c.println(F(\"Content-Type: text/plain\"));\\n  c.println(F(\"Connection: close\"));\\n  c.println();\\n  c.print(muLeft, 3); c.print(','); c.print(lamRight, 3);\\n  c.print(','); c.print(currentState);\\n  c.print(','); c.print(lpaNomeEstado(currentState));\\n  c.print(','); c.print(distLeft, 1);\\n  c.print(','); c.print(distRight, 1);\\n  c.stop();\\n  return;\\n}"
                    },
                    "next": {
                      "block": {
                        "type": "ard_raw_stmt",
                        "id": ".HZ~Q^RuvGJCn5=*[0pB",
                        "fields": {
                          "CODE": "c.println(F(\"HTTP/1.1 200 OK\"));\\nc.println(F(\"Content-Type: text/html; charset=utf-8\"));\\nc.println(F(\"Connection: close\"));\\nc.println();\\nsendPage(c);\\nc.stop();"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "ard_function_def",
          "id": "38maHi)Y#pa*@9LYd^9?",
          "x": 40,
          "y": 1498,
          "fields": {
            "TIPO": "void",
            "NOME": "waitServing",
            "PARAMS": "unsigned long ms"
          },
          "inputs": {
            "BODY": {
              "block": {
                "type": "ard_raw_stmt",
                "id": "KE^Q@/!)w{w9Zo)g4tB/",
                "icons": {
                  "comment": {
                    "text": "a plain delay() would leave the page silent during the 2 s turn. This\nwait serves the browser while the robot maneuvers - the point keeps\nmoving",
                    "pinned": false,
                    "height": 80,
                    "width": 160
                  }
                },
                "fields": {
                  "CODE": "unsigned long t0 = millis();\\nwhile (millis() - t0 < ms) { serveWeb(); delay(2); }"
                }
              }
            }
          }
        },
