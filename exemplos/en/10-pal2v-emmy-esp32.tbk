                "id": "2|PGI~M*jH)$AF7#CsLA",
                "icons": {
                  "comment": {
                    "text": "IN1 D2 / IN2 D4 = left motor | IN3 D18 / IN4 D19 = right. ENA and ENB\nare on the 5 V jumpers, always enabled: the speed comes from the\ndirection pin itself. All four at 0: stopped. Always analogWrite on\nthese pins, never digitalWrite - on the ESP32 analogWrite ties the pin\nto the LEDC and a digital write would not take",
                    "pinned": false,
                    "height": 80,
                    "width": 160
                  }
                },
